{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nirakar Chat",
  "version": "0.1.0",
  "identifier": "com.nirakar.chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nirakar Chat",
        "width": 1024,
        "height": 768,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {},
      "nsis": {}
    },
    "linux": {
      "deb": {
        "depends": ["webkit2gtk-4.1", "curl", "wget"]
      },
      "appimage": {},
      "rpm": {}
    }
  }
}
